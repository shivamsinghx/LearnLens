# LearnLens environment template.
# Copy the app-specific example into a local env file. Never commit those copies.
#
#   frontend/.env.example -> frontend/.env.local
#   backend/.env.example  -> backend/.env
#
# This repository must not contain real API keys, passwords, or tokens.

# Browser-visible base URL for the LearnLens API.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
