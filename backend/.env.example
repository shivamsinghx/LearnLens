# LearnLens API configuration.
# Copy this file to backend/.env for local development.
# Never commit .env, and never put real secrets in this example.

APP_NAME=LearnLens
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# Local directory for uploaded PDFs (created automatically if missing).
# UPLOAD_DIR=./storage/uploads

# Local open-source embedding model (sentence-transformers).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Must match the embedding model output size (bge-small-en-v1.5 => 384).
EMBEDDING_DIMENSION=384

# PostgreSQL + pgvector (matches docker-compose.yml defaults).
# SQLAlchemy URL uses the psycopg 3 driver.
DATABASE_URL=postgresql+psycopg://learnlens:learnlens@127.0.0.1:5432/learnlens

# Minimum cosine similarity for retrieval hits (tune with evaluation data).
RETRIEVAL_MIN_SIMILARITY=0.3

# Planned for later stages.
# GEMMA_MODEL=
