# LearnLens API configuration.
# Copy this file to backend/.env for local development.
# Never commit .env, and never put real secrets in this example.

APP_NAME=LearnLens
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# Local directory for uploaded PDFs (created automatically if missing).
# UPLOAD_DIR=./storage/uploads

# Planned for later stages. Leave these unset until those stages exist.
# DATABASE_URL=
# EMBEDDING_MODEL=
# GEMMA_MODEL=
